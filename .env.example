# 统一配置模板：默认用于 Docker 生产部署，本地开发调整项见 README。
# 首次部署复制为 .env 并填写真实配置；已有 .env 时合并配置，保留实际凭据。
# ================ Application ================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=replace-with-a-random-application-secret

# ================ External Docker networks ================
DEPENDS_MAIN_NETWORK=depends_main
DEPENDS_PROXY_NETWORK=depends_proxy

# ================ Docker frontend HTTP ================
# 宿主机 HTTP 端口，用于通过 http://服务器IP:端口/ 访问公开博客。
FRONTEND_HTTP_PORT=8100

# ================ Docker build ================
# Debian 软件源根地址，不包含 /debian；可改为 https://deb.debian.org。
# Docker 镜像加速地址不会加速容器内的 APT 下载。
DEBIAN_MIRROR=https://mirrors.aliyun.com
# Python 包索引地址；可改为 https://pypi.org/simple。
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# ================ JWT ================
JWT_SECRET=replace-with-a-random-jwt-secret
JWT_ALGORITHM=HS256
# 登录 Token 有效期，单位分钟，默认 30 天；修改后重新登录生效。
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ================ MySQL ================
# 当前远端已有 root 账号；密码填写 depends 中实际的 MySQL 密码。
# 如改用业务账号，先创建该账号并授予 MYSQL_DATABASE 的权限。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-depends-mysql-password
MYSQL_DATABASE=sudothink

# 初始化脚本创建数据库时使用的 root 密码备用值；MYSQL_ADMIN_PASSWORD 优先于此项。
# 应用运行时不读取此项，已有数据库且不再用 root 初始化时可以留空。
MYSQL_ROOT_PASSWORD=

# 初始化建库默认沿用 MYSQL_USER/MYSQL_PASSWORD，不创建或授权 MySQL 账号。
# 如需单独的建库账号，可设置以下变量：
# MYSQL_ADMIN_USER=root
# MYSQL_ADMIN_PASSWORD=replace-with-mysql-admin-password

# ================ Redis ================
# depends 当前使用 default 用户，与后端的密码认证方式一致。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-depends-redis-password

# ================ RabbitMQ / Celery ================
# RabbitMQ 由外部容器提供，与应用接入 DEPENDS_MAIN_NETWORK，网络别名为 rabbitmq。
# 使用独立的非 guest 用户，确认目标 vhost 已存在，并授予该用户对应权限。
# 用户名、密码和 vhost 填写原始值，应用会在构造连接地址时编码特殊字符。
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=sudothink
RABBITMQ_PASSWORD=replace-with-a-strong-rabbitmq-password
# 默认使用 /；也可填写已创建并授权的专用 vhost。
RABBITMQ_VHOST=/
# 默认不保存任务结果；需要时填写 Celery 支持的结果后端 URL。
CELERY_RESULT_BACKEND=
CELERY_TIMEZONE=Asia/Shanghai
CELERY_WORKER_CONCURRENCY=2

# ================ CORS ================
# 本地 Vite 开发时按 README 配置 localhost 和两个域名的 :8100 Origin。
CORS_ORIGINS=https://www.example.com,https://admin.example.com

# 评论来源 IP：只信任下列明确的代理 IP/CIDR，多个用逗号分隔。
# 默认留空，忽略所有转发头，使用连接对端 IP。Docker 部署填写实际代理网络范围。
# 不要填写 0.0.0.0/0 或 ::/0；本地 Vite 代理可填写 127.0.0.1/32,::1/128。
TRUSTED_PROXY_CIDRS=
# 传统 QQWry IPv4 .dat 数据库；相对路径始终相对 backend 目录。
# 仓库提供默认数据库，可替换为更新的兼容文件；缺失、损坏或 IPv6 时显示“未知”。
# Docker 将 QQWRY_DATA_DIR 挂载到 /app/data；本地运行不使用 QQWRY_DATA_DIR。
QQWRY_DATA_DIR=./backend/data
QQWRY_DB_PATH=data/qqwry.dat

# ================ WeChat sharing ================
# 微信公众号后台「设置与开发 → 基本配置」中的开发者 ID 和开发者密码。
# 仅后端使用，不能提交真实值，也不要改成 VITE_ 前缀。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ================ Frontend (Vite) ================
VITE_API_BASE_URL=/api
# 页脚显示的 ICP 备案号；留空时隐藏，修改后需重新构建前端。
VITE_ICP_NUMBER=

# ================ Alibaba Cloud ================
# 访问密钥只在后端和资源发布进程使用，严禁给密钥加 VITE_ 前缀或提交真实值。
# 使用专用 RAM 用户，限制到对应 Bucket 的 media/*、static/*，不要使用主账号密钥。
# OSS 上传与后台 CDN 运维共用此凭据。CDN 另需 RefreshObjectCaches、PushObjectCache、DescribeRefreshTasks 权限。
ACCESS_KEY_ID=
ACCESS_KEY_SECRET=
# 使用 STS 临时凭据时一并填写，到期后需更新；长期 RAM 凭据时留空。
OSS_REGION=cn-hangzhou
OSS_BUCKET=
# 公网地域 Endpoint，上传直连 OSS；按 Bucket 的实际地域填写。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 阿里云 CDN 的 HTTPS 资源域名，可包含路径前缀，例如 https://cdn.example.com。
# 不填写 OSS/CDN 时禁用本地文件上传，原有图片 URL 插入仍可使用。
# 生产前端资源自动使用 CDN_BASE_URL/OSS_STATIC_PREFIX/；CDN 留空时使用站点本身。
# 此项和 OSS_STATIC_PREFIX 为公开的前端构建参数，修改任一项后需重新构建前端。
CDN_BASE_URL=
OSS_MEDIA_PREFIX=media
# 静态资源固定目录；发布会覆盖同名文件，上传后需手动刷新 CDN 目录缓存。
OSS_STATIC_PREFIX=static
OSS_IMAGE_MAX_BYTES=10485760
OSS_VIDEO_MAX_BYTES=209715200
# 新上传图片、视频的缓存时长，单位秒，默认一年；0 写入 no-store。
OSS_MEDIA_CACHE_SECONDS=31536000

# ================ Initial administrator ================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
