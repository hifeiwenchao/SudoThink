# 统一配置模板：默认用于 Docker 生产部署，本地开发调整项见 README。
# 首次部署复制为 .env 并填写真实配置；已有 .env 时合并配置，保留实际凭据。
# ================ Application ================
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=replace-with-a-random-application-secret

# ================ External Docker networks ================
DEPENDS_MAIN_NETWORK=depends_main
DEPENDS_PROXY_NETWORK=depends_proxy

# ================ Docker frontend HTTP ================
# 宿主机 HTTP 端口，用于通过 http://服务器IP:端口/ 访问公开博客。
FRONTEND_HTTP_PORT=8100

# ================ Docker build ================
# Debian 软件源根地址，不包含 /debian；可改为 https://deb.debian.org。
# Docker 镜像加速地址不会加速容器内的 APT 下载。
DEBIAN_MIRROR=https://mirrors.aliyun.com
# Python 包索引地址；可改为 https://pypi.org/simple。
PYPI_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# ================ JWT ================
JWT_SECRET=replace-with-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ================ MySQL ================
# 当前远端已有 root 账号；密码填写 depends 中实际的 MySQL 密码。
# 如改用业务账号，先创建该账号并授予 MYSQL_DATABASE 的权限。
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-depends-mysql-password
MYSQL_DATABASE=sudothink

# 初始化建库默认沿用 MYSQL_USER/MYSQL_PASSWORD，不创建或授权 MySQL 账号。
# 如需单独的建库账号，可设置以下变量：
# MYSQL_ADMIN_USER=root
# MYSQL_ADMIN_PASSWORD=replace-with-mysql-admin-password

# ================ Redis ================
# depends 当前使用 default 用户，与后端的密码认证方式一致。
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=replace-with-depends-redis-password

# ================ CORS ================
# 本地 Vite 开发时按 README 配置 localhost 和两个域名的 :8100 Origin。
CORS_ORIGINS=https://www.feiwenchao.com,https://admin.feiwenchao.com

# ================ Frontend (Vite) ================
VITE_API_BASE_URL=/api

# ================ Initial administrator ================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@feiwenchao.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
