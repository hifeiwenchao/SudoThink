# ================ Application ================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-strong-random-secret

# ================ JWT ================
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120

# ================ MySQL ================
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=blog
MYSQL_PASSWORD=blog_password
MYSQL_DATABASE=sudothink
MYSQL_ROOT_PASSWORD=root_password

# ================ Redis ================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ================ CORS ================
CORS_ORIGINS=http://localhost,http://localhost:5173

# ================ Frontend (Vite) ================
VITE_API_BASE_URL=/api
